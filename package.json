{
  "name": "todoapp",
  "version": "0.1.0",
  "private": true,
  "description": "TypeSafe (System One) でタスクを自動分類・優先度づけする最小CLIデモ",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "todo-classify": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "classify": "node dist/cli.js",
    "demo": "node dist/cli.js --demo"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
